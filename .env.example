# 复制为 .env 后填写，勿提交真实密钥

# ---- LLM（OpenAI 兼容接口）----
# 示例用 DeepSeek，可换成通义/Kimi/本地 vLLM/Ollama
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# ---- 角色人设 ----
AVATAR_NAME=小海
AVATAR_PERSONA=一个温柔又有点好奇心的AI伙伴

# ---- 记忆库 ----
MEMORY_DB_PATH=./data/memory.db

# ---- 音频 ----
AUDIO_SAMPLE_RATE=24000
