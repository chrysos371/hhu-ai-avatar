# 复制为 .env 后填写，勿提交真实密钥

# ---- LLM（OpenAI 兼容接口）----
# 方案A：本地 Ollama（免费、离线；先 `ollama pull qwen2.5:7b`）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
#
# 方案B：云端 DeepSeek / 通义 / Kimi / 本地 vLLM 等
LLM_BASE_URL=https://api.deepseek.com/v1
# 留空运行规则 demo；接入云端服务时填写真实密钥。
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 角色人设 ----
AVATAR_NAME=小海
AVATAR_PERSONA=一个温柔又有点好奇心的AI伙伴

# ---- 记忆库 ----
MEMORY_DB_PATH=./data/memory.db

# 可选语义召回：先 ollama pull bge-m3，再将模型名设为 bge-m3。
# 留空时仅使用关键词检索；服务失败自动退回关键词检索。
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT=10
EMBEDDING_MIN_SIMILARITY=0.45

# ---- 音频 ----
AUDIO_SAMPLE_RATE=24000

# ---- 可选联网工具 ----
# 先安装 requirements-web.txt；网页按需勾选联网，CLI用/search或/read。
# 默认自动使用系统代理；如需覆盖，填写可信HTTP CONNECT代理URL。
# AVATAR_WEB_PROXY=
# 资料查询只读取下列白名单目录中的 .md/.txt；Windows 多目录用分号分隔。
# AVATAR_DOCUMENT_ROOTS=C:\Users\你的用户名\Documents\课程资料;C:\path\to\project\docs

# ---- 可选 QQ 官方机器人（独立服务，不开放管理后台）----
# 在 QQ 开放平台创建机器人并开通单聊/群内@消息权限；凭据仅填本机 .env。
AVATAR_QQ_APP_ID=
AVATAR_QQ_APP_SECRET=
# 留空使用项目 data/qq；不同实例不要共享此目录。
# AVATAR_QQ_STATE_DIR=/data/Users/zyyh/hhu-ai-avatar/data/qq
# 群内@的共享额度（按机器人+群计算，重启保留）；私聊不应用此群限流。
AVATAR_QQ_GROUP_COOLDOWN=2
AVATAR_QQ_GROUP_PER_MINUTE=2
AVATAR_QQ_GROUP_PER_HOUR=20
# 安静时段使用 UTC+8；默认关闭。启用示例 23/7，期间群内@也静默，私聊仍回应。
AVATAR_QQ_QUIET_START=-1
AVATAR_QQ_QUIET_END=-1

# ---- 默认普通 QQ 号：NapCat / OneBot 11 正向 WebSocket ----
# NapCat 的 WebSocket 服务端设为本机回环地址，消息格式 array；不需要 AppID。
AVATAR_ONEBOT_QQ=
AVATAR_ONEBOT_TOKEN=
AVATAR_ONEBOT_WS_URL=ws://127.0.0.1:6700
# AVATAR_ONEBOT_STATE_DIR=/data/Users/zyyh/hhu-ai-avatar/data/qq-onebot

# QQ 读取后台已确认的人设和知识；此知识库内容会供 QQ 用户查询，请只放可共享资料。
# 默认沿用 MEMORY_DB_PATH（项目 data/memory.db）。不共享后台的个人记忆。
# AVATAR_QQ_ADMIN_DB=/data/Users/zyyh/hhu-ai-avatar/data/memory.db
# 额外公开给 QQ 的资料目录（仅 md/txt），默认不读取网页端的私人目录。
# 多个目录用系统路径分隔符；只允许 /data/Users/zyyh 内明确发布的目录。
# AVATAR_QQ_DOCUMENT_ROOTS=/data/Users/zyyh/hhu-ai-avatar/data/qq-documents

# Optional configured model profiles; setting a profile does not start its server.
# Copy config/model-profiles.example.json to a private workspace path and edit it.
AVATAR_MODEL_PROFILES=
# Optional global profile for web/QQ. Role gallery selects profiles independently.
AVATAR_MODEL_PROFILE=

# 按需任务技能；默认关闭，1启用。只提供上下文方法，不授予工具权限。
AVATAR_SKILLS_ENABLED=0

# 接梗独立试验开关；还需AVATAR_SKILLS_ENABLED=1。
AVATAR_BANTER_ENABLED=0
