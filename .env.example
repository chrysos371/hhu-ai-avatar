# 复制为 .env 后填写，勿提交真实密钥

# ---- LLM（OpenAI 兼容接口）----
# 方案A：本地 Ollama（免费、离线；先 `ollama pull qwen2.5:7b`）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
#
# 方案B：云端 DeepSeek / 通义 / Kimi / 本地 vLLM 等
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# ---- 角色人设 ----
AVATAR_NAME=小海
AVATAR_PERSONA=一个温柔又有点好奇心的AI伙伴

# ---- 记忆库 ----
MEMORY_DB_PATH=./data/memory.db

# ---- 音频 ----
AUDIO_SAMPLE_RATE=24000
