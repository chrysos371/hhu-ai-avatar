# 复制为 .env 后填写，勿提交真实密钥

# ---- LLM（OpenAI 兼容接口）----
# 方案A：本地 Ollama（免费、离线；先 `ollama pull qwen2.5:7b`）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
#
# 方案B：云端 DeepSeek / 通义 / Kimi / 本地 vLLM 等
LLM_BASE_URL=https://api.deepseek.com/v1
# 留空运行规则 demo；接入云端服务时填写真实密钥。
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 角色人设 ----
AVATAR_NAME=小海
AVATAR_PERSONA=一个温柔又有点好奇心的AI伙伴

# ---- 记忆库 ----
MEMORY_DB_PATH=./data/memory.db

# 可选语义召回：先 ollama pull bge-m3，再将模型名设为 bge-m3。
# 留空时仅使用关键词检索；服务失败自动退回关键词检索。
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT=10
EMBEDDING_MIN_SIMILARITY=0.45

# ---- 音频 ----
AUDIO_SAMPLE_RATE=24000

# ---- 可选联网工具 ----
# 先安装 requirements-web.txt；网页按需勾选联网，CLI用/search或/read。
# 默认自动使用系统代理；如需覆盖，填写可信HTTP CONNECT代理URL。
# AVATAR_WEB_PROXY=
# 资料查询只读取下列白名单目录中的 .md/.txt；Windows 多目录用分号分隔。
# AVATAR_DOCUMENT_ROOTS=C:\Users\你的用户名\Documents\课程资料;C:\path\to\project\docs
