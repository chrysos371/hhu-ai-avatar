        n = len(frames)
        if n == 0:
            return []
    
        times = np.arange(n) * self.hop_ms / 1000.0
        # 能量（RMS）与静音判定
        energy = np.sqrt(np.mean(frames**2, axis=1))
        peak = energy.max() if energy.size else 0.0
        if not np.isfinite(peak) or peak <= 1e-8:
            return [LipSyncFrame(float(t), 0.0, "", 0.0) for t in times]
