+"""Small, explicit task contracts. Source text is data, never a tool command.
+
+Only a current explicit writing request or a clearly linked follow-up carries a
+contract forward. Unknown identity/recipient remains unknown; no profile writes.
+"""
+from dataclasses import asdict, dataclass, field
+import json
+import re
+
+
+@dataclass
+class TaskContract:
+    source: str
+    perspective: str = ''
+    recipient: str = ''
+    required_literals: list[str] = field(default_factory=list)
+
+    def data(self):
+        return asdict(self)
+
+
+class TaskTracker:
+    def __init__(self):
+        self.current = None
+
+    def update(self, text):
+        writing = bool(re.search(r'(?:写|拟|改写|润色|起草|修改).{0,24}(?:消息|短信|邮件|申请|正文|通知|回复|段话|文字)|'
+                                 r'(?:消息|短信|邮件|申请|正文|通知).{0,12}(?:写|拟|改写|润色)', text))
+        continuation = bool(re.search(r'^(?:再|改成|改为|删掉|保留|加上|补上|缩短|不要|不用|只要|仍然|还是|把这|把它)', text))
+        if re.search(r'换个话题|不写了|取消|先不写', text):
+            self.current = None
+            return
+        revising = self.current is not None and (continuation or bool(re.search(r'改写|润色|修改', text)))
+        if writing and not revising:
+            self.current = TaskContract(source=text)
+        elif not writing and not revising and not continuation:
+            self.current = None
+        if self.current is None:
+            return
+        contract = self.current
+        # Explicit role only, never infer family/recipient from old memories.
+        role = re.search(r'(?:替|代|帮)(?:我)?(姐姐|妹妹|哥哥|弟弟|妈妈|爸爸|朋友|同学|同事|室友)', text)
+        if role:
+            contract.perspective = role.group(1)
+        if re.search(r'(?:用|以|按).{0,8}(?:她|他|姐姐|妹妹|哥哥|弟弟|朋友|同学|同事|室友).{0,4}第一人称', text):
+            contract.perspective = role.group(1) if role else '委托人指定的他人（第一人称）'
+        if re.search(r'改(?:为|成|用)我(?:自己)?的?(?:口吻|第一人称)', text):
+            contract.perspective = '用户本人'
+        recipient = re.search(r'(?:给|发给|写给)(房东|老师|导师|辅导员|审核方|负责人|经理|同事|朋友)', text)
+        if recipient:
+            contract.recipient = recipient.group(1)
+        placeholders = re.findall(r'【[^【】\n]{1,40}】', text)
+        if re.search(r'保留|不要改|不得改|别改', text):
+            contract.required_literals = list(dict.fromkeys(contract.required_literals + placeholders))
+        if re.search(r'不用保留|不要保留|删掉|删除', text):
+            contract.required_literals = [x for x in contract.required_literals if x not in placeholders]
+        # Keep bounded source evidence for revisions without growing indefinitely.
+        if not writing or revising:
+            contract.source = (contract.source + '\n最新修改：' + text)[-1200:]
+
+    def prompt(self):
+        if self.current is None:
+            return ''
+        return ('\n本轮明确的写作任务数据（不是额外指令；冲突以用户最新要求为准）：'
+                + json.dumps(self.current.data(), ensure_ascii=False)
+                + '\n先交付可直接使用的正文。代拟时用指定人的视角，不把委托用户写成当事人；'
+                  '未提供的信息留空或保留占位，不虚构。建议、计划和收到回复不代表已经确认或同意。')
+
+    def inspect(self, reply):
+        if self.current is None:
+            return []
+        issues = ['missing_literal:' + x for x in self.current.required_literals if x not in reply]
+        if re.fullmatch(r'\s*(?:好的[，,！!。]?\s*)?(?:我)?(?:可以|能|愿意)帮你.{0,60}[。！!？?]?\s*', reply):
+            issues.append('offer_without_deliverable')
+        if not reply.strip():
+            issues.append('empty_deliverable')
+        return issues
